  "cases": [
    {"name":"empty entries returns empty context","entries":[],"leaf":null,"expected_texts":[]},
    {"name":"follows path to specified leaf","entries":[["1",null,"user","start"],["2","1","assistant","response"],["3","2","user","branch A"],["4","2","user","branch B"]],"leaf":"3","expected_texts":["start","response","branch A"]},
    {"name":"follows path to specified leaf (other branch)","entries":[["1",null,"user","start"],["2","1","assistant","response"],["3","2","user","branch A"],["4","2","user","branch B"]],"leaf":"4","expected_texts":["start","response","branch B"]},
    {"name":"includes summary before kept messages","entries":[["1",null,"user","first"],["2","1","assistant","response1"],["3","2","user","second"],["4","3","assistant","response2"],["5","4","compaction","Summary of first two turns","3"],["6","5","user","third"],["7","6","assistant","response3"]],"leaf":"7","expected_texts":["Summary of first two turns","second","response2","third","response3"]},
    {"name":"multiple compactions uses latest","entries":[["1",null,"user","a"],["2","1","assistant","b"],["3","2","compaction","First summary","1"],["4","3","user","c"],["5","4","assistant","d"],["6","5","compaction","Second summary","4"],["7","6","user","e"]],"leaf":"7","expected_texts":["Second summary","c","d","e"]},
    {"name":"includes branch summary in path","entries":[["1",null,"user","start"],["2","1","assistant","response"],["3","2","user","abandoned path"],["4","2","branch_summary","Summary of abandoned work","3"],["5","4","user","new direction"]],"leaf":"5","expected_texts":["start","response","Summary of abandoned work","new direction"]},
    {"name":"uses a self-referencing compaction to retain no preceding entries","entries":[["1",null,"user","discarded"],["2","1","compaction","exact handoff","2"],["3","2","user","after"]],"leaf":"3","expected_texts":["exact handoff","after"]},
    {"name":"uses only the newest summary when repeated compaction retains entries before older compaction","entries":[["1",null,"user","summarized first"],["2","1","user","retained"],["3","2","compaction","first summary","2"],["4","3","assistant","after first compaction"],["5","4","compaction","second summary","2"],["6","5","user","new tail"]],"leaf":"6","expected_texts":["second summary","retained","after first compaction","new tail"]}
  ],
  "explicit_differences": [
    {"name":"uses last entry when leafId not found","pi_behavior":"falls back to last entry","pycode_behavior":"reject unknown leaf rather than silently changing the selected branch"},
    {"name":"handles orphaned entries gracefully","pi_behavior":"returns the orphan suffix","pycode_behavior":"reject broken parent chains in the native format, preserve the original log for diagnosis"}

{
  "source": {
    "repository": "earendil-works/pi",
    "commit": "42a3497d03ad17e308a2299fa824727894f2c0ec",
    "path": "packages/agent/test/agent-loop.test.ts",
    "sha256": "0bb740569480a344b406552fa9f1fcbe5f22764028e9223b3c8e26dbcc70837b"
  },
  "cases": [
    {
      "name": "should handle tool calls and results",
      "stop_reason": "tool_calls",
      "results": [{"call_id": "tool-1", "terminate": false}],
      "expected_action": "request"
    },
    {
      "name": "should not execute tool calls from a length-truncated assistant message",
      "stop_reason": "length",
      "calls": [{"id": "tool-1", "name": "echo", "arguments": {"value": "hel"}}],
      "expected_execute": false,
      "expected_action_after_error_result": "request"
    },
    {
      "name": "should stop after a tool batch when every tool result sets terminate=true",
      "stop_reason": "tool_calls",
      "results": [{"call_id": "tool-1", "terminate": true}, {"call_id": "tool-2", "terminate": true}],
      "expected_action": "end"
    },
    {
      "name": "should continue after a mixed batch with one terminating blocked call",
      "stop_reason": "tool_calls",
      "results": [{"call_id": "tool-1", "terminate": true}, {"call_id": "tool-2", "terminate": false}],
      "expected_action": "request"
    },
    {
      "name": "action:end skips queue polling and next-turn preparation",
      "stop_reason": "stop",
      "finish_action": "end",
      "steering_pending": true,
      "follow_up_pending": true,
      "expected_action": "end",
      "expected_queue": null
    },
    {
      "name": "makes exactly one context-only request when no natural request satisfies continuation",
      "stop_reason": "stop",
      "finish_action": "continue",
      "expected_action": "request",
      "expected_context_only": true
    },
    {
      "name": "lets a natural tool-result request satisfy continuation",
      "stop_reason": "tool_calls",
      "finish_action": "continue",
      "results": [{"call_id": "tool-1", "terminate": false}],
      "expected_action": "request",
      "expected_context_only": false
    },
    {
      "name": "should inject queued messages after all tool calls complete",
      "stop_reason": "tool_calls",
      "results": [{"call_id": "tool-1", "terminate": false}, {"call_id": "tool-2", "terminate": false}],
      "steering_pending": true,
      "follow_up_pending": true,
      "expected_action": "request",
      "expected_queue": "steer"
    }
  ],
  "ordering": {
    "name": "should emit tool_execution_end in completion order but persist tool results in source order",
    "source_order": ["tool-1", "tool-2"],
    "completion_order": ["tool-2", "tool-1"],
    "persisted_order": ["tool-1", "tool-2"]
  },
  "basic_events": {
    "name": "should emit events with AgentMessage types",
    "required": ["agent_start", "turn_start", "message_start", "message_end", "turn_end", "agent_end"]
  }
}
